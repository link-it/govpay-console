{
  "logo": {
    "full": "assets/images/logo/LINK_logo-Govpay.svg",
    "compact": "assets/images/logo/LINK_GovPay-icon.svg",
    "showTitle": true,
    "fallbackText": "GP"
  },
  "primaryColor": "#84cc16",
  "secondaryColor": "#1e1b18",
  "theme": {
    "topBar": {
      "background": "#ffffff",
      "text": "#1e1b18",
      "border": "#e4f4cc",
      "height": "3.5rem"
    },
    "header": {
      "background": "#ffffff",
      "text": "#1e1b18",
      "border": "#e4f4cc",
      "showShadow": false
    },
    "sidebar": {
      "background": "#ffffff",
      "border": "#e4f4cc",
      "text": "#1e1b18",
      "textSecondary": "#6f6a63",
      "itemHover": "#eef8de80",
      "itemActive": "#e6f5d0",
      "itemActiveText": "#4e790d",
      "footerBackground": "#ffffff",
      "footerBorder": "#e4f4cc"
    },
    "content": {
      "background": "#f6fbef",
      "text": "#1e1b18",
      "cardBackground": "#ffffff",
      "cardBorder": "#e4f4cc",
      "cardHover": "#f6fbef",
      "muted": "#f0f9e3",
      "mutedForeground": "#6f6a63"
    },
    "buttons": {
      "primaryBackground": "#84cc16",
      "primaryText": "#16202b",
      "primaryHover": "#74b413",
      "secondaryBackground": "#ffffff",
      "secondaryText": "#1e1b18",
      "secondaryBorder": "#e4f4cc",
      "secondaryHover": "#eef8de80"
    },
    "tabs": {
      "shared": {
        "textActive": "#1e1b18",
        "fontWeightActive": 600
      },
      "underline": {
        "indicatorColor": "#84cc16",
        "indicatorSize": "3px",
        "trackBorder": "#e4f4cc"
      },
      "segmented": {
        "trackBackground": "#f0f9e3",
        "trackRadius": "0.75rem",
        "pillBackground": "#84cc16",
        "pillText": "#16202b",
        "pillShadow": "0 1px 3px rgb(132 204 22 / 0.35)",
        "badgeBackgroundActive": "#1f1d1a1a",
        "badgeTextActive": "#1f1d1a"
      }
    },
    "fonts": {
      "primary": {
        "family": "Roboto"
      }
    },
    "success": "#16a34a",
    "warning": "#f59e0b",
    "danger": "#dc2626",
    "info": "#0071a9",
    "dark": {
      "topBar": {
        "background": "#14120f",
        "text": "#e8e6e3",
        "border": "#2c2822"
      },
      "header": {
        "background": "#14120f",
        "text": "#e8e6e3",
        "border": "#2c2822",
        "showShadow": false
      },
      "sidebar": {
        "background": "#14120f",
        "border": "#2c2822",
        "text": "#e8e6e3",
        "textSecondary": "#a1998e",
        "itemHover": "#2c2822",
        "itemActive": "#2c2822",
        "itemActiveText": "#b5e073",
        "footerBackground": "#14120f",
        "footerBorder": "#2c2822"
      },
      "content": {
        "background": "#0e0c0a",
        "text": "#e8e6e3",
        "cardBackground": "#1d1a16",
        "cardBorder": "#2c2822",
        "cardHover": "#2c2822",
        "muted": "#2c2822",
        "mutedForeground": "#a1998e"
      },
      "buttons": {
        "primaryBackground": "#84cc16",
        "primaryText": "#1f1d1a",
        "primaryHover": "#74b413",
        "secondaryBackground": "#2c2822",
        "secondaryText": "#e8e6e3",
        "secondaryBorder": "#3a352c",
        "secondaryHover": "#3a352c"
      },
      "tabs": {
        "shared": {
          "textActive": "#e8e6e3"
        },
        "underline": {
          "trackBorder": "#2c2822"
        },
        "segmented": {
          "trackBackground": "#2c2822",
          "pillBackground": "#84cc16",
          "pillText": "#1f1d1a",
          "pillShadow": "0 1px 3px rgb(132 204 22 / 0.45)"
        }
      },
      "info": "#38bdf8"
    }
  }
}
