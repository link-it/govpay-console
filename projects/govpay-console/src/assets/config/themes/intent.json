{
  "logo": {
    "full": "assets/images/logo/LINK_logo-Govpay.svg",
    "compact": "assets/images/logo/LINK_GovPay-icon.svg",
    "showTitle": true,
    "fallbackText": "GP"
  },
  "primaryColor": "#0ea5e9",
  "secondaryColor": "#1e1b18",
  "theme": {
    "topBar": {
      "background": "#ffffff",
      "text": "#1e1b18",
      "border": "#caebfa",
      "height": "3.5rem"
    },
    "header": {
      "background": "#ffffff",
      "text": "#1e1b18",
      "border": "#caebfa",
      "showShadow": false
    },
    "sidebar": {
      "background": "#ffffff",
      "border": "#caebfa",
      "text": "#1e1b18",
      "textSecondary": "#6f6a63",
      "itemHover": "#ddf2fc80",
      "itemActive": "#cfedfb",
      "itemActiveText": "#0b87bf",
      "footerBackground": "#ffffff",
      "footerBorder": "#caebfa"
    },
    "content": {
      "background": "#eef9fd",
      "text": "#1e1b18",
      "cardBackground": "#ffffff",
      "cardBorder": "#caebfa",
      "cardHover": "#eef9fd",
      "muted": "#e2f4fc",
      "mutedForeground": "#6f6a63"
    },
    "buttons": {
      "primaryBackground": "#0ea5e9",
      "primaryText": "#ffffff",
      "primaryHover": "#0c91cd",
      "secondaryBackground": "#ffffff",
      "secondaryText": "#1e1b18",
      "secondaryBorder": "#caebfa",
      "secondaryHover": "#ddf2fc80"
    },
    "tabs": {
      "shared": {
        "textActive": "#1e1b18",
        "fontWeightActive": 600
      },
      "underline": {
        "indicatorColor": "#0ea5e9",
        "indicatorSize": "3px",
        "trackBorder": "#caebfa"
      },
      "segmented": {
        "trackBackground": "#e2f4fc",
        "trackRadius": "0.75rem",
        "pillBackground": "#0ea5e9",
        "pillText": "#ffffff",
        "pillShadow": "0 1px 3px rgb(14 165 233 / 0.35)",
        "badgeBackgroundActive": "#ffffff33",
        "badgeTextActive": "#ffffff"
      }
    },
    "fonts": {
      "primary": {
        "family": "Prompt"
      }
    },
    "success": "#16a34a",
    "warning": "#f59e0b",
    "danger": "#dc2626",
    "info": "#0071a9",
    "dark": {
      "topBar": {
        "background": "#14120f",
        "text": "#e8e6e3",
        "border": "#2c2822"
      },
      "header": {
        "background": "#14120f",
        "text": "#e8e6e3",
        "border": "#2c2822",
        "showShadow": false
      },
      "sidebar": {
        "background": "#14120f",
        "border": "#2c2822",
        "text": "#e8e6e3",
        "textSecondary": "#a1998e",
        "itemHover": "#2c2822",
        "itemActive": "#2c2822",
        "itemActiveText": "#6ec9f2",
        "footerBackground": "#14120f",
        "footerBorder": "#2c2822"
      },
      "content": {
        "background": "#0e0c0a",
        "text": "#e8e6e3",
        "cardBackground": "#1d1a16",
        "cardBorder": "#2c2822",
        "cardHover": "#2c2822",
        "muted": "#2c2822",
        "mutedForeground": "#a1998e"
      },
      "buttons": {
        "primaryBackground": "#0ea5e9",
        "primaryText": "#ffffff",
        "primaryHover": "#0c91cd",
        "secondaryBackground": "#2c2822",
        "secondaryText": "#e8e6e3",
        "secondaryBorder": "#3a352c",
        "secondaryHover": "#3a352c"
      },
      "tabs": {
        "shared": {
          "textActive": "#e8e6e3"
        },
        "underline": {
          "trackBorder": "#2c2822"
        },
        "segmented": {
          "trackBackground": "#2c2822",
          "pillBackground": "#0ea5e9",
          "pillText": "#ffffff",
          "pillShadow": "0 1px 3px rgb(14 165 233 / 0.45)"
        }
      },
      "info": "#38bdf8"
    }
  }
}
