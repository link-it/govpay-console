{
  "AppConfig": {
    "app": {
      "name": "govpay-console",
      "title": "GovPay Console",
      "description": "Console di backoffice GovPay"
    },
    "STANDALONE": true,
    "GOVAPI": {
      "GOVPAY": "/govpay-api-backoffice/rs/form/v1",
      "CONSOLE": "/govpay-console-api",
      "GOVHUB": ""
    },
    "Auth": {
      "Modes": [
        "Basic",
        "Spid",
        "Iam",
        "OAuth2"
      ],
      "Default": "Basic",
      "Endpoints": {
        "login": "/login",
        "logout": "/logout",
        "spid": "/spid/login",
        "oauth2": "/oauth2/authorize",
        "iam": "/iam/login"
      }
    },
    "Layout": {
      "showHeaderBar": true,
      "showFooterBar": false,
      "profileMenuPosition": "sidebar",
      "darkModeTogglePosition": "none",
      "languageSelectorPosition": "none",
      "settingsMenuPosition": "profile",
      "languages": [
        {
          "code": "it",
          "label": "Italiano",
          "short": "IT",
          "flag": "🇮🇹"
        },
        {
          "code": "en",
          "label": "English",
          "short": "EN",
          "flag": "🇬🇧"
        }
      ],
      "defaultLanguage": "it",
      "showAbout": true,
      "showVersion": true,
      "showBuild": false,
      "profileMenuExtraItems": [
        {
          "labelKey": "Profile.MenuItems.UserGuide",
          "icon": "bootstrapQuestionCircle",
          "link": "https://lab.link.it/documentazione/govpay/",
          "target": "_blank"
        }
      ],
      "sidebarFooterItems": [],
      "listView": "table",
      "listViewByFeature": {
        "pendenze": "rows",
        "domini": "rows",
        "giornale-eventi": "rows",
        "applicazioni": "rows",
        "tracciati": "rows",
        "rendicontazioni": "rows",
        "intermediari": "rows"
      },
      "searchPillVariant": "square",
      "gotoTopButton": true,
      "helpButton": true,
      "tweaksPanel": true,
      "listMaxWidth": "none",
      "detailMaxWidth": "64rem"
    },
    "Features": {
      "GESTIONE_PAGAMENTI": true,
      "MENU_PENDENZE": true,
      "MENU_RICEVUTE": true,
      "MENU_PAGAMENTI": false,
      "GESTIONE_RISCOSSIONI": true,
      "MENU_RISCOSSIONI": false,
      "MENU_RENDICONTAZIONI": true,
      "MENU_INCASSI": false,
      "GESTIONE_MONITORAGGIO": true,
      "MENU_GIORNALE_EVENTI": true,
      "MENU_TRACCIATI": false,
      "GESTIONE_ANAGRAFICHE": true,
      "MENU_DOMINI": false,
      "MENU_TIPI_PENDENZA": false,
      "MENU_APPLICAZIONI": false,
      "MENU_INTERMEDIARI": true,
      "GESTIONE_SICUREZZA": true,
      "MENU_OPERATORI": true,
      "MENU_RUOLI": true,
      "GESTIONE_IMPOSTAZIONI": true,
      "MENU_IMPOSTAZIONI": false
    },
    "Preferences": {
      "TIMEOUT": 30000,
      "PAGE_SIZE": 25
    },
    "Maintenance": {
      "enabled": false,
      "title": "Servizio in manutenzione",
      "message": "Il portale è temporaneamente non disponibile per interventi di manutenzione. Riprova più tardi.",
      "icon": "bootstrapGear"
    }
  }
}
